 "components": {
  "schemas": {
   "AskIn": {
    "properties": {
     "session_id": {
      "anyOf": [
       {
        "type": "integer"
       },
       {
        "type": "null"
       }
      ],
      "title": "Session Id"
     },
     "message": {
      "type": "string",
      "title": "Message"
     }
    },
    "type": "object",
    "required": [
     "message"
    ],
    "title": "AskIn"
   },
   "Body_create_audit_api_audits_post": {
    "properties": {
     "input_type": {
      "type": "string",
      "enum": [
       "text",
       "html",
       "pdf",
       "image"
      ],
      "title": "Input Type",
      "default": "text"
     },
     "text": {
      "anyOf": [
       {
        "type": "string"
       },
       {
        "type": "null"
       }
      ],
      "title": "Text"
     },
     "file": {
      "anyOf": [
       {
        "type": "string",
        "contentMediaType": "application/octet-stream"
       },
       {
        "type": "null"
       }
      ],
      "title": "File"
     },
     "surface": {
      "type": "string",
      "enum": [
       "ecommerce",
       "quick_commerce",
       "brand_site",
       "social_post"
      ],
      "title": "Surface",
      "default": "ecommerce"
     },
     "category": {
      "type": "string",
      "enum": [
       "home",
       "beauty",
       "personal",
       "food"
      ],
      "title": "Category",
      "default": "home"
     },
     "brand": {
      "type": "string",
      "title": "Brand",
      "default": ""
     },
     "paid": {
      "type": "boolean",
      "title": "Paid",
      "default": false
     },
     "sample_id": {
      "anyOf": [
       {
        "type": "string"
       },
       {
        "type": "null"
       }
      ],
      "title": "Sample Id"
     }
    },
    "type": "object",
    "title": "Body_create_audit_api_audits_post"
   },
   "FlagPatch": {
    "properties": {
     "action": {
      "type": "string",
      "enum": [
       "accept",
       "dismiss",
       "escalate",
       "set_risk"
      ],
      "title": "Action"
     },
     "risk": {
      "anyOf": [
       {
        "type": "string",
        "enum": [
         "high",
         "medium",
         "low"
        ]
       },
       {
        "type": "null"
       }
      ],
      "title": "Risk"
     },
     "reason_code": {
      "anyOf": [
       {
        "type": "string",
        "enum": [
         "wrong_clause",
         "not_a_claim",
         "substantiated",
         "puffery",
         "wrong_risk",
         "other"
        ]
       },
       {
        "type": "null"
       }
      ],
      "title": "Reason Code"
     },
     "note": {
      "anyOf": [
       {
        "type": "string"
       },
       {
        "type": "null"
       }
      ],
      "title": "Note"
     },
     "reviewer": {
      "anyOf": [
       {
        "type": "string"
       },
       {
        "type": "null"
       }
      ],
      "title": "Reviewer"
     }
    },
    "type": "object",
    "required": [
     "action"
    ],
    "title": "FlagPatch"
   },
   "HTTPValidationError": {
    "properties": {
     "detail": {
      "items": {
       "$ref": "#/components/schemas/ValidationError"
      },
      "type": "array",
      "title": "Detail"
     }
    },
    "type": "object",
